# ── Portfolio Models — ortam değişkenleri ───────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın. Hiçbiri zorunlu değildir: boş bırakırsanız uygulama
# tek kullanıcılı, girişsiz modda açılır ve veriler /data/portfolios.db (SQLite) içinde tutulur.

# Uygulamanın dinleyeceği port (host tarafı)
PM_PORT=8501

# ── Çok kullanıcılı kurulum: Google ile giriş ──────────────────────────────────
# Doldurulursa giriş zorunlu olur ve her kullanıcı yalnızca kendi kayıtlarını görür.
# Kurulum adımları: docs/self-hosting.md#google-login
# PM_PUBLIC_URL=https://portfoy.example.com
# PM_OAUTH_CLIENT_ID=
# PM_OAUTH_CLIENT_SECRET=
# Rastgele uzun bir değer: python -c "import secrets; print(secrets.token_hex(32))"
# PM_COOKIE_SECRET=

# ── Veritabanı ───────────────────────────────────────────────────────────────
# Boşsa SQLite kullanılır. Postgres profiliyle (docker compose --profile postgres up):
# PM_DATABASE_URL=postgresql+psycopg://portfolio_models:change-me@db:5432/portfolio_models
# POSTGRES_PASSWORD=change-me

# ── Enflasyon verisi (isteğe bağlı) ─────────────────────────────────────────────
# TCMB EVDS anahtarı: https://evds3.tcmb.gov.tr → Profil → API Anahtarı. Boşsa OECD kullanılır.
# PM_EVDS_API_KEY=

# ── Haftalık e-posta (mailer profili) ───────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=           # Gmail için uygulama şifresi: https://myaccount.google.com/apppasswords
# MAIL_FROM=Portfolio Models <you@gmail.com>
# APP_URL=https://portfoy.example.com
