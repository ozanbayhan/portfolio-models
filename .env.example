# ── Portfolio Models — environment variables ────────────────────────────────────
# Copy to .env. Everything is optional: left empty, the app starts in single-user mode
# without sign-in and stores data in /data/portfolios.db (SQLite).
# Full reference: docs/self-hosting.md

# Host port
PM_PORT=8501

# ── Multi-user: sign in with Google (or any OIDC provider) ─────────────────────
# When set, sign-in is required and every user sees only their own data.
# Step by step: docs/self-hosting.md#google-login
# PM_PUBLIC_URL=https://pm.example.com
# PM_OAUTH_CLIENT_ID=
# PM_OAUTH_CLIENT_SECRET=
# Long random value: python -c "import secrets; print(secrets.token_hex(32))"
# PM_COOKIE_SECRET=
# Other OIDC providers (default: Google)
# PM_OAUTH_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration

# ── Database ────────────────────────────────────────────────────────────────────
# Empty = SQLite. With the postgres profile (docker compose --profile postgres up -d):
# PM_DATABASE_URL=postgresql+psycopg://portfolio_models:change-me@db:5432/portfolio_models
# POSTGRES_PASSWORD=change-me

# ── Inflation data (optional) ──────────────────────────────────────────────────
# TCMB EVDS key: https://evds3.tcmb.gov.tr → Profile → API key. Falls back to OECD.
# PM_EVDS_API_KEY=

# ── Weekly email (email profile) ───────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=           # Gmail app password: https://myaccount.google.com/apppasswords
# MAIL_FROM=Portfolio Models <you@gmail.com>
# APP_URL=https://pm.example.com
